# 水利 RAG + Agent 配置模板
# 复制此文件为 .env 并填写真实配置

# 应用基础
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO
DATA_ROOT=./data
# 允许的前端 Origin，逗号分隔。默认同时允许 localhost 与 127.0.0.1。
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# 额外允许的 Origin（逗号分隔）。生产留空；smoke_test / 灰度场景按需注入。
# EXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8123

# DashScope 云服务
DASHSCOPE_API_KEY=your_api_key_here
LLM_MODEL=qwen-plus
LLM_MODEL_HARD=qwen-max
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# Rerank 精排（可选增强）：若账号未开通该模型，系统自动降级为"仅用检索结果"。
# 可用模型以百炼控制台"模型广场"实际可开通为准；当前 gte-rerank 在部分区域不提供。
RERANK_MODEL=gte-rerank

# 超时/重试/预算
HTTP_TRUST_ENV=false
LLM_TIMEOUT_S=60
MAX_RETRIES=2
MAX_AGENT_STEPS=12
MAX_MULTI_QUERIES=3
DAILY_CALL_LIMIT=1000

# 本地数据路径
SQLITE_PATH=./data/water.db
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=water_knowledge
SOURCE_PATH=./data/source
LOG_PATH=./data/logs
BACKUP_PATH=./data/backups

# 检索初始参数
DENSE_TOP_K=30
BM25_TOP_K=30
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_TOP_K=8
