# 水利 RAG + Agent 配置模板
# 复制此文件为 .env 并填写真实配置

# 应用基础
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO
# 应用版本：单一来源 backend/__init__.py.__version__，health 探针 / OpenAPI 自动跟随。
# 仅灰度/品牌场景需覆盖时才设置 APP_VERSION，平时无需配置。
DATA_ROOT=./data
# 认证密钥：非本地环境（APP_ENV != local，如 production/staging）必填，缺失将拒绝启动（fail-fast）。
# 本地/开发留空时用进程级随机值（重启后旧登录态失效，仅限开发便利）。
# 生成方式（任选其一）：
#   - 线上随机串:  python -c "import secrets; print(secrets.token_hex(32))"
#   - 任意强随机 64 字符长字符串
TOKEN_SECRET=
# 短时效 access token 有效期（秒）：默认 30 分钟
ACCESS_TOKEN_TTL_S=1800
# 长时效 refresh token 有效期（秒）：默认 7 天（轮换 + 可吊销）
REFRESH_TOKEN_TTL_S=604800
# 登录防爆破：同一 username 连续失败超限进入锁定（窗口内有效）
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_S=900
LOGIN_LOCKOUT_S=900
# 注册安全（G10.5）：开放注册总开关（生产可关）+ 注册按 IP 滑动窗口限流（防批量注册）
ALLOW_REGISTRATION=true
REGISTER_MAX_PER_WINDOW=10
REGISTER_WINDOW_S=3600
# admin bootstrap 显式化：非空时仅该用户名的首个注册者获得 admin，其余一律普通用户。
# 例：ADMIN_BOOTSTRAP_USERNAME=root —— 攻击者抢先注册任意其他名字也拿不到 admin。
# 留空则保持旧行为（首个注册者即 admin，仅限内部/演示环境）。
ADMIN_BOOTSTRAP_USERNAME=
# 允许的前端 Origin，逗号分隔。默认同时允许 localhost 与 127.0.0.1。
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# 额外允许的 Origin（逗号分隔）。生产留空；smoke_test / 灰度场景按需注入。
# EXTRA_ALLOWED_ORIGINS=http://127.0.0.1:8123

# DashScope 云服务
DASHSCOPE_API_KEY=your_api_key_here
# 兼容 OpenAI 协议端点（LLM / Embedding 统一走这里）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DashScope 原生 Rerank 端点（与 base_url 协议不同）
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/reranking/text-reranking/text-reranking
LLM_MODEL=qwen-plus
LLM_MODEL_HARD=qwen-max
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# Rerank 精排（可选增强）：若账号未开通该模型，系统自动降级为"仅用检索结果"。
# 可用模型以百炼控制台"模型广场"实际可开通为准；当前 gte-rerank 在部分区域不提供。
RERANK_MODEL=gte-rerank

# 超时/重试/预算
HTTP_TRUST_ENV=false
LLM_TIMEOUT_S=60
MAX_RETRIES=2
MAX_AGENT_STEPS=12
MAX_MULTI_QUERIES=3
DAILY_CALL_LIMIT=1000
# 每用户每分钟请求上限（chat/upload 等重端点）
RATE_LIMIT_PER_MINUTE=30

# LLM 成本核算（元/百万 token），用于 /admin/usage 用量成本换算
LLM_PRICE_INPUT_PER_M=0.8
LLM_PRICE_OUTPUT_PER_M=2.0

# 本地数据路径
SQLITE_PATH=./data/water.db
# SQLite 连接池大小（<=1 禁用池化，测试/调试用 0）
DB_POOL_SIZE=5
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=water_knowledge
SOURCE_PATH=./data/source
LOG_PATH=./data/logs
BACKUP_PATH=./data/backups
# 备份自动化（G5.2）：定时备份开关；关闭时 scripts.backup_cron 跳过备份（调度保留）
BACKUP_ENABLED=true
# 备份保留天数：超过的旧备份目录在下次备份后被清理
BACKUP_RETENTION_DAYS=7

# 跨进程状态后端（G5.3）：留空用内存实现（单进程部署）；
# 多实例/多 worker 部署时填 redis 连接串，限流/预算计数跨进程共享
# REDIS_URL=redis://localhost:6379/0

# 摄取任务持久化队列
# 应用进程内跑一个 asyncio worker（本地默认）；生产可另起 `python -m scripts.worker` 多进程
INGESTION_WORKER_IN_PROCESS=true
INGESTION_QUEUE_POLL_SECONDS=1.0
# 任务租约（秒）：claimed 后超过该时长未完成视为 worker 崩溃，启动时回收
INGESTION_TASK_LEASE_SECONDS=600
# 单个任务最大尝试次数，超限标 failed（不再自动重试）
INGESTION_MAX_ATTEMPTS=3

# 检索初始参数
DENSE_TOP_K=30
BM25_TOP_K=30
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RERANK_TOP_K=8
